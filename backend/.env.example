# MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=pairpocket

# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://localhost:3000

# Secret used to sign the app JWT and the OAuth session.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Optional dedicated key for encrypting user secrets (Gemini API key) at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a key is derived from SECRET_KEY. Set this in production (Heroku config).
# SETTINGS_ENCRYPTION_KEY=

# Google OAuth 2.0 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" registered in Google Cloud Console.
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Where the backend redirects the user after a successful login.
FRONTEND_URL=http://localhost:3000

# --- Sign-in sessions ---
# Access tokens are short-lived; the frontend renews them with a rotating
# HttpOnly refresh cookie. Leave ACCESS_TOKEN_EXPIRE_MINUTES unset in production.
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=30
# Safari drops Secure cookies on http://localhost; set false for local Safari testing.
# SESSION_COOKIE_SECURE=true

# Local preview login without Google (never enable in production)
# ALLOW_DEV_LOGIN=true

# Staging test accounts (Tester 1-4) with a shared password and a reset button
# on the sign-in page. Ignored unless MONGODB_DB_NAME ends in _staging, _test or _dev.
# TEST_LOGIN_PASSWORD=

# --- Email (Resend — recommended, one API key for the whole app) ---
# 1. https://resend.com 가입 (무료)
# 2. API Keys → Create → 복사
# 3. 아래에 붙여넣기 → 백엔드 재시작
# 사용자는 별도 설정 없이 Google 로그인 이메일로 알림을 받습니다.
RESEND_API_KEY=
EMAIL_FROM=PairPocket <onboarding@resend.dev>

# --- Cron (daily subscription reminder emails) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# GitHub Actions calls POST /api/internal/cron/subscription-reminders with header X-Cron-Secret
CRON_SECRET=

# --- Legacy SMTP (optional, only if you prefer Gmail SMTP) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true
